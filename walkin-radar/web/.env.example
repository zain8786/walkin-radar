# Copy to .env.local for local development. Set the same names in Vercel.
# SUPABASE_URL is the Project URL. SUPABASE_PUBLISHABLE_KEY is the publishable key
# (or the anon key on older projects). Only the server reads these; the browser never does.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
